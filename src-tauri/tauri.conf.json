{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valtracker",
  "version": "../package.json",
  "identifier": "com.i4nis.valtracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Valtracker",
        "width": 1440,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://media.valorant-api.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://valorant-api.com https://media.valorant-api.com",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "I4NIS",
    "shortDescription": "Suivi de performances Valorant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5QTQ2NTBBMzYxNzVFRjEKUldUeFhoYzJDbVdrMmV3TGFvWUowTTF4YjNFQWNSNmxZaDR1TjYrekxZWnBqT09zSjdyZmNiU1YK",
      "endpoints": ["https://github.com/I4NIS/valtracker/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
